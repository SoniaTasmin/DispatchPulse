# Copy to .env and change the passwords. .env is git-ignored; never commit it.
# Local development values only.

# --- Docker Compose ---
MYSQL_ROOT_PASSWORD=change-me-root
API_DB_PASSWORD=change-me-api
WORKER_DB_PASSWORD=change-me-worker
RABBITMQ_DEFAULT_USER=dispatchpulse
RABBITMQ_DEFAULT_PASS=change-me-rabbit
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- API (apps/api, running on the host) ---
# The password in both URLs must match API_DB_PASSWORD.
# allowPublicKeyRetrieval: MySQL 8.4 auth (caching_sha2_password) without TLS needs the server's
# public key on the first login after each MySQL restart. Fine locally; use TLS in a real deployment.
PORT=3000
DATABASE_URL=mysql://dispatchpulse_api:change-me-api@localhost:3306/dispatchpulse?allowPublicKeyRetrieval=true
SHADOW_DATABASE_URL=mysql://dispatchpulse_api:change-me-api@localhost:3306/dispatchpulse_shadow?allowPublicKeyRetrieval=true
# Integration tests migrate and wipe this database, never the one above.
TEST_DATABASE_URL=mysql://dispatchpulse_api:change-me-api@localhost:3306/dispatchpulse_test?allowPublicKeyRetrieval=true

# --- RabbitMQ (API and worker). The password must match RABBITMQ_DEFAULT_PASS. ---
RABBITMQ_URL=amqp://dispatchpulse:change-me-rabbit@localhost:5672
# Integration tests use their own virtual host (created by the test setup), never the default one.
TEST_RABBITMQ_URL=amqp://dispatchpulse:change-me-rabbit@localhost:5672/dispatchpulse_test

# --- Notification worker (apps/notification-worker). Passwords must match WORKER_DB_PASSWORD. ---
WORKER_DATABASE_URL=mysql://dispatchpulse_worker:change-me-worker@localhost:3306/dispatchpulse_notifications?allowPublicKeyRetrieval=true
WORKER_SHADOW_DATABASE_URL=mysql://dispatchpulse_worker:change-me-worker@localhost:3306/dispatchpulse_notifications_shadow?allowPublicKeyRetrieval=true
TEST_WORKER_DATABASE_URL=mysql://dispatchpulse_worker:change-me-worker@localhost:3306/dispatchpulse_notifications_test?allowPublicKeyRetrieval=true
# Delay before a failed event is retried, and total processing attempts before the dead-letter queue.
RETRY_DELAY_MS=5000
MAX_ATTEMPTS=3
# Demo only: comma-separated event types the worker fails on purpose, e.g. workorder.completed
SIMULATE_FAILURE_EVENT_TYPES=

{
  "uid": "dispatchpulse",
  "title": "DispatchPulse",
  "description": "API health, work-order activity and event delivery, with the two SLOs.",
  "tags": [
    "dispatchpulse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "API health",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "API availability \u00b7 99% SLO",
      "description": "SLI = non-5xx requests / all requests over the selected time range. 4xx counts as served correctly. Green at or above the 99% demo target.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d6453d",
                "value": null
              },
              {
                "color": "#3f9b6a",
                "value": 0.99
              }
            ]
          },
          "mappings": [],
          "noValue": "No traffic"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(http_requests_total{job=\"api\",status!~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_requests_total{job=\"api\"}[$__range]))",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "95th-percentile request duration over the last 5 minutes, estimated from histogram buckets. Shown for visibility; not a formal SLO.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#1f4fd1"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8a94a3",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "No traffic"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"api\"}[5m])))",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "description": "All API requests per second (scrapes and health checks excluded). Per-route detail is in the metric, labelled by route template.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 7,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5b8def"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "5xx error ratio",
      "description": "Share of requests that failed on the server side. 4xx are not errors here: the API handled those requests correctly.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 7,
        "x": 17,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#d6453d"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{job=\"api\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total{job=\"api\"}[$__rate_interval]))",
          "legendFormat": "5xx share",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "row",
      "title": "Work orders and outbox",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Lifecycle transitions / min",
      "description": "Committed state changes by the status entered. OPEN = work order created.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "OPEN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5b8def"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ASSIGNED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8f6bd8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IN_PROGRESS"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d99a1e"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "COMPLETED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3f9b6a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (to_status) (increase(workorder_transitions_total[65s]))",
          "legendFormat": "{{to_status}}",
          "refId": "A"
        }
      ],
      "interval": "1m",
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Pending outbox events",
      "description": "Events committed in MySQL but not yet confirmed by RabbitMQ. Rises during a broker outage and drains when it recovers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 10,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5b8def"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(outbox_pending_events)",
          "legendFormat": "pending",
          "refId": "A"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Outbox publish failures / min",
      "description": "Failed publish attempts (broker unavailable, unroutable or not confirmed). Each one leaves the event pending for the next poll.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 17,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#d99a1e"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(outbox_publish_failures_total[65s]))",
          "legendFormat": "failed attempts",
          "refId": "A"
        }
      ],
      "interval": "1m",
      "id": 9
    },
    {
      "type": "row",
      "title": "Event worker",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Events handled / min",
      "description": "Final successful outcomes. 'duplicate' = a redelivered event that was already processed (absorbed by the UNIQUE event_id constraint).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "processed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3f9b6a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duplicate"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5b8def"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(notification_events_total[65s]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "interval": "1m",
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Retries / min",
      "description": "Failed attempts scheduled for another try after a delay. Intermediate, not a final failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#d99a1e"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(notification_event_retries_total[65s]))",
          "legendFormat": "retries",
          "refId": "A"
        }
      ],
      "interval": "1m",
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Dead-lettered / min",
      "description": "Events that used up their attempts or were invalid, now in the DLQ.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 14,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#d6453d"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 85,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMax": 1
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(notification_events_dead_lettered_total[65s]))",
          "legendFormat": "dead-lettered",
          "refId": "A"
        }
      ],
      "interval": "1m",
      "id": 13
    },
    {
      "type": "stat",
      "title": "Event processing \u00b7 99% SLO",
      "description": "SLI = (processed + duplicate) / (processed + duplicate + dead-lettered, excluding the simulated demo failures) over the selected time range. Retries are not final outcomes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d6453d",
                "value": null
              },
              {
                "color": "#3f9b6a",
                "value": 0.99
              }
            ]
          },
          "mappings": [],
          "noValue": "No traffic"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(notification_events_total[$__range])) or vector(0)) / ((sum(increase(notification_events_total[$__range])) or vector(0)) + (sum(increase(notification_events_dead_lettered_total{reason!=\"simulated\"}[$__range])) or vector(0)))",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 14
    },
    {
      "type": "stat",
      "title": "Dead-letter alert",
      "description": "Prometheus alert EventsDeadLettered: anything dead-lettered in the last 10 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3f9b6a",
                "value": null
              },
              {
                "color": "#d6453d",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": null,
                "result": {
                  "text": "FIRING",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "No traffic"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(ALERTS{alertname=\"EventsDeadLettered\",alertstate=\"firing\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "id": 15
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
